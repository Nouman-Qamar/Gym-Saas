## Ironline — single source of truth for local config.
## Copy this file to `.env` and fill in your own values.

# Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymsaas?schema=public"

# Long random string used to sign session (JWT) cookies. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Public app URL (used for QR check-in links, invite links, PWA metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Name shown across the product — change this to white-label the whole app for a gym owner.
NEXT_PUBLIC_APP_NAME="Ironline"

## ── Email (password reset, welcome email, payment reminders) ──────────────
## Provider: Resend (resend.com). Leave blank and emails are logged to the
## server console instead of sent — nothing breaks without a key.
RESEND_API_KEY=""
EMAIL_FROM="Ironline <onboarding@resend.dev>"

## ── SMS (payment reminders, booking confirmations) ─────────────────────────
## Provider: Twilio (twilio.com). Leave blank and SMS are logged instead of sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

## ── Web push notifications ──────────────────────────────────────────────
## Generate your own keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@yourgym.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

## ── Online payments ──────────────────────────────────────────────────────
# Which gateway members' "Pay online" button uses: "stripe" | "jazzcash" | "off"
PAYMENT_GATEWAY="off"

# Stripe (stripe.com) — Developers > API keys (use test keys first).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# JazzCash (jazzcash.com.pk) — from your merchant dashboard (sandbox or live).
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
